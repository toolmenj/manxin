# 複製成 .env 後修改。.env 不進版控。

# 伺服器
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
# 前端網址（開信連結、登入連結會指向這裡）
APP_URL=http://localhost:5173

# 資料庫（docker compose 的 postgres 對外開 5433，避免和本機既有的 5432 衝突）
DATABASE_URL=postgres://manxin:manxin@localhost:5433/manxin
# 設成 pglite 可改用記憶體內的 PostgreSQL（不需要 Docker，資料不會保存）
# DB_DRIVER=pglite

# 簽 session、開信連結用的密鑰。正式環境務必換成長亂數。
APP_SECRET=change-me-to-a-long-random-string

# 寄信：console（預設，印在 log 並存進 dev_outbox）或 resend（尚未實作）
MAILER=console
MAIL_FROM="慢信 <letters@manxin.example>"
# RESEND_API_KEY=

# 天氣：mock（預設，原型的決定性隨機）或 cwa（中央氣象署，尚未實作）
WEATHER_PROVIDER=mock
# CWA_API_KEY=

# 附件存放位置（開發用本機磁碟）
UPLOAD_DIR=./uploads
UPLOAD_MAX_BYTES=10485760

# 排程：在 API 同一個程序裡跑 worker（開發方便）；正式環境建議另開 npm run worker
WORKER_INLINE=true
WORKER_INTERVAL_MS=30000

# 開發用時鐘偏移（毫秒），等同原型右上角的「快轉」。正式環境（NODE_ENV=production）一律忽略。
DEV_CLOCK_OFFSET_MS=0
